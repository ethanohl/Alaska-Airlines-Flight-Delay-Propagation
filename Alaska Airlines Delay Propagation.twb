      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1spg0t806obplc11cjbaj0lkwp9y].[sum:inherited_delay_min:qk]&quot;' value='Inherited' />
          <alias key='&quot;[federated.1spg0t806obplc11cjbaj0lkwp9y].[sum:original_delay_min:qk]&quot;' value='Original' />
        </aliases>
      </column>
      <column caption='Inherited Share' datatype='real' default-format='p0.0%' name='[Calculation_1794452130656260]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([inherited_delay_min]) / (SUM([inherited_delay_min]) + SUM([original_delay_min]))' />
      </column>
      <column caption='On-Time Rate' datatype='real' default-format='p0.0%' name='[Calculation_1794452130844677]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([on_time_departure])' />
      </column>
      <column caption='Morning Window' datatype='string' name='[Calculation_1794452130897926]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [dep_hour] &gt;= 7 AND [dep_hour] &lt;= 11 THEN &quot;7–11 AM&quot; ELSE &quot;Other hours&quot; END' />
      </column>
      <column caption='Flight Duration' datatype='real' name='[Calculation_2356303206932480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;minute&apos;, [sched_dep], [sched_arr]) / 1440' />
      </column>
      <column aggregation='Sum' caption='Includes SFO' datatype='integer' name='[Calculation_2356303207026689]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [chain_id] : MAX(IF [origin] = &quot;SFO&quot; OR [dest] = &quot;SFO&quot; THEN 1 ELSE 0 END) }' />
      </column>
