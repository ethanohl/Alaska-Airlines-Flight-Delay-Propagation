    <worksheet name='Inherited Share by Segment'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Short inter-island hops inherit more delay (38% vs. 26%)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='flights' name='federated.1spg0t806obplc11cjbaj0lkwp9y' />
